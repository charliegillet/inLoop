#!/usr/bin/env python3
"""Open the local inLoop app, starting its web server if needed."""
import argparse
import json
from pathlib import Path
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parent
URL = 'http://127.0.0.1:8790'


def ready():
    try:
        with urllib.request.urlopen(URL + '/api/state', timeout=1) as response:
            value = json.load(response)
        return isinstance(value, dict) and {'current_session', 'sessions', 'events', 'tasks', 'csrf'}.issubset(value)
    except (OSError, ValueError, urllib.error.URLError):
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--no-open', action='store_true', help='Start the app without opening a browser')
    args = parser.parse_args()
    if not ready():
        with socket.socket() as check:
            if check.connect_ex(('127.0.0.1', 8790)) == 0:
                print('Port 8790 is occupied by an unavailable app. Check logs/inloop-app.log.', file=sys.stderr)
                return 1
        python = ROOT / '.venv/bin/python'
        if not python.exists():
            print('The project Python environment is missing: .venv/bin/python', file=sys.stderr)
            return 1
        logs = ROOT / 'logs'
        logs.mkdir(exist_ok=True)
        with (logs / 'inloop-app.log').open('ab') as output:
            process = subprocess.Popen([str(python), str(ROOT / 'inloop_app.py')], cwd=ROOT,
                                       stdin=subprocess.DEVNULL, stdout=output, stderr=output,
                                       start_new_session=True)
        for _ in range(60):
            if ready():
                (logs / 'inloop-app.pid').write_text(str(process.pid) + '\n')
                break
            if process.poll() is not None:
                print('inLoop could not start. See logs/inloop-app.log.', file=sys.stderr)
                return 1
            time.sleep(.15)
        else:
            print('inLoop is still starting. See logs/inloop-app.log.', file=sys.stderr)
            return 1
    print(URL)
    if not args.no_open:
        subprocess.run(['open', URL], check=False)
    return 0


if __name__ == '__main__':
    sys.exit(main())
