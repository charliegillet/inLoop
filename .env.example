# Active inLoop speech: Vexo -> Bluetooth -> Mac -> Pipecat -> Deepgram Nova-3.
# Existing OMI_* names remain compatibility settings. Process variables override this file.
OMI_STT_BACKEND=deepgram
# Configure the private Deepgram key below.
# DEEPGRAM_API_KEY=your-private-api-key
# Install requirements-pipecat.txt with its lockfile in .venv-pipecat first.
OMI_DEEPGRAM_PIPELINE=pipecat
# OMI_PIPECAT_PYTHON=/absolute/path/to/.venv-pipecat/bin/python
# OMI_DEEPGRAM_MODEL=nova-3
# OMI_DEEPGRAM_ENDPOINTING_MS=300
# Deepgram provides transcript speaker separation through diarization.
# Deepgram requests always set mip_opt_out=true and redact_usage=true.

# Historical local-Whisper maintenance settings (not the active inLoop path).
# Defaults: .venv-whisper/bin/python and ~/Library/Application Support/OmiWhisper/.
# OMI_WHISPER_PYTHON=/absolute/path/to/python3.14
# OMI_WHISPER_MODEL=/absolute/path/to/whisper-turbo
# OMI_WHISPER_VAD=/absolute/path/to/silero_vad.onnx

# Match this private token in the Vexo source and Mac bridge configuration.
# OMI_STREAM_TOKEN=choose-a-private-stream-token
# Captions use the stream token by default. Set a separate viewer token if needed.
# An explicitly empty OMI_CAPTION_TOKEN enables anonymous captions.
# OMI_CAPTION_TOKEN=choose-a-private-viewer-token

# Language settings reach the selected recognizer on every launch.
OMI_LANGUAGE=en
OMI_LANGUAGES=en
# Whisper only, for Arabic and English: OMI_LANGUAGE=auto and OMI_LANGUAGES=en,ar
# Use a short sentence for domain terms; empty disables vocabulary biasing.
# OMI_HOTWORDS=

# Bound caption fan-out per bridge; each viewer has its own bounded queue.
OMI_MAX_CAPTION_CLIENTS=16

# Skip unsent audio older than this during normal operation.
OMI_MAX_AUDIO_AGE_SEC=45.0
# Start a new session after this much idle time.
OMI_IDLE_FLUSH_SEC=8.0

# Speaker separation and local voice matching are separate explicit choices.
OMI_DEEPGRAM_DIARIZE=true
OMI_DEEPGRAM_KEYTERMS=[]
OMI_VOICE_IDENTIFICATION=false
# OMI_SPEAKER_PYTHON=/absolute/path/to/.venv-speaker/bin/python
